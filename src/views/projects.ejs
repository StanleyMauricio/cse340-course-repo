<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        
        <p>Explore our active volunteer opportunities:</p>
        
        <ul>
            <% projects.forEach(project => { %>
                <% 
                    const formattedDate = new Date(project.project_date).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                    });
                %>
                <li>
                    <strong><%= formattedDate %></strong>: 
                    <%= project.title %> 
                    (<em><%= project.organization_name %></em>)
                    <br>
                    <small>📍 <%= project.location %> — <%= project.description %></small>
                </li>
            <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>