<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <ul>
        <% categories.forEach(cat => { %>
            <li>
                <a href="/category/<%= cat.category_id %>">
                    <strong><%= cat.name %></strong>
                </a>
                <% if (cat.description) { %>
                    <p><%= cat.description %></p>
                <% } %>
            </li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>