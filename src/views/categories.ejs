<%- include('partials/header') %>
<main>
    <h1>Categories</h1>
    
    <div style="margin-bottom: 20px;">
        <a href="/new-category" class="btn">Add New Category</a>
    </div>

    <ul>
        <% categories.forEach(cat => { %>
            <li>
                <a href="/category/<%= cat.category_id %>"><%= cat.name %></a>
            </li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>