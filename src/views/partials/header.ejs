<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'CSE 340 Service Network' %></title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <header>
        <nav>
            <a href="/">Home</a>
            <a href="/organizations">Organizations</a>
            <a href="/projects">Projects</a>
            <a href="/categories">Categories</a>
            <% if (typeof user !== 'undefined' && user) { %>
                <a href="/dashboard">Dashboard</a>
                <a href="/logout">Logout</a>
            <% } else { %>
                <a href="/login">Login</a>
                <a href="/register">Register</a>
            <% } %>
        </nav>
    </header>

    <!-- Mensajes Flash -->
    <% if (typeof messages !== 'undefined' && messages && messages.error) { %>
        <div class="flash-message error"><%= messages.error %></div>
    <% } %>
    <% if (typeof messages !== 'undefined' && messages && messages.success) { %>
        <div class="flash-message success"><%= messages.success %></div>
    <% } %>