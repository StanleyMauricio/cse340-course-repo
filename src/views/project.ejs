<%- include('partials/header') %>
<main>
    <h1><%= project.title %></h1>
    <p><%= project.description %></p>
    <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString() %></p>
    <p><strong>Location:</strong> <%= project.location %></p>
    <p><strong>Organization:</strong> <%= project.organization_name %></p>

    <h3>Categories:</h3>
    <% if (categories && categories.length > 0) { %>
        <!-- Categorías en formato vertical exigido por la rúbrica -->
        <ul style="display: flex; flex-direction: column; gap: 8px; list-style: none; padding: 0;">
            <% categories.forEach(cat => { %>
                <li>
                    <a href="/category/<%= cat.category_id %>" style="display: block; background: #e0e0e0; padding: 6px 12px; border-radius: 4px; text-decoration: none; width: fit-content;">
                        <%= cat.name %>
                    </a>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No categories assigned.</p>
    <% } %>

    <!-- Volunteer Section -->
    <div class="volunteer-section" style="margin-top: 20px;">
        <% if (typeof user !== 'undefined' && user) { %>
            <% if (isVolunteer) { %>
                <p>You are volunteering for this project.</p>
                <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                    <button type="submit" class="btn-danger">Unvolunteer</button>
                </form>
            <% } else { %>
                <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                    <button type="submit" class="btn-primary">Sign up as Volunteer</button>
                </form>
            <% } %>
        <% } else { %>
            <p><a href="/login">Log in</a> to volunteer for this project.</p>
        <% } %>
    </div>
 
    <% if (user && user.role_name === 'admin') { %>
        <div style="margin-top: 20px; display: flex; gap: 10px;">
            <a href="/assign-categories/<%= project.project_id %>" class="btn">Edit Categories</a>
            <a href="/edit-project/<%= project.project_id %>" class="btn">Edit Project</a>
        </div>
    <% } %>
</main>
<%- include('partials/footer') %>