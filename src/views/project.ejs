<%- include('partials/header') %>
<main>
    <h1><%= project.title %></h1>
    <p><%= project.description %></p>
    <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString() %></p>
    <p><strong>Location:</strong> <%= project.location %></p>

    <h3>Categories:</h3>
    <% if (categories && categories.length > 0) { %>
        <ul style="display: flex; gap: 10px; list-style: none; padding: 0;">
            <% categories.forEach(cat => { %>
                <li>
                    <a href="/category/<%= cat.category_id %>" style="background: #e0e0e0; padding: 4px 8px; border-radius: 4px; text-decoration: none;">
                        <%= cat.name %>
                    </a>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No categories assigned.</p>
    <% } %>

    
    <p style="margin-top: 15px;">
        <a href="/assign-categories/<%= project.project_id %>" class="btn">Edit Categories</a>
    </p>
</main>
<%- include('partials/footer') %>